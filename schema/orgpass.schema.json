{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/thethinkred-ai/interop-map/main/schema/orgpass.schema.json",
  "title": "Паспорт организации (orgpass) v1.0",
  "description": "Голос самой организации: самоописание для карты взаимодействия. Позиции принимаются только с источниками. Черновик (asserted=false) составлен по открытым данным и не является заявлением организации.",
  "type": "object",
  "required": ["schema_version", "id", "asserted", "identity"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.0" },
    "id": { "type": "string", "pattern": "^ORG-[0-9]{3,4}$" },
    "asserted": {
      "type": "boolean",
      "description": "true — организация подтвердила паспорт своим публичным каналом; false — черновик по открытым данным"
    },
    "asserted_date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "identity": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "maxLength": 160 },
        "aliases": { "type": "array", "items": { "type": "string", "maxLength": 160 } },
        "country": { "type": "string", "maxLength": 80 },
        "geography": { "type": "string", "maxLength": 300 },
        "languages": { "type": "array", "items": { "type": "string", "maxLength": 40 } },
        "legal_form": { "type": "string", "maxLength": 160, "description": "партия / общественное объединение / инициатива / незарегистрированная группа / медиа / …" },
        "founded": { "type": "string", "maxLength": 40 },
        "status": { "type": "string", "maxLength": 200, "description": "действует / приостановлена / не установлено" }
      }
    },
    "channels": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "site": { "type": "string", "format": "uri" },
        "telegram": { "type": "string" },
        "vk": { "type": "string" },
        "youtube": { "type": "string" },
        "email": { "type": "string" },
        "other": { "type": "array", "items": { "type": "string" } }
      }
    },
    "positions": {
      "type": "array",
      "description": "Позиции организации. Каждая — с источником. Отсутствие темы означает «не заявлено», а не согласие или несогласие.",
      "items": {
        "type": "object",
        "required": ["topic", "stance", "status"],
        "additionalProperties": false,
        "properties": {
          "topic": { "$ref": "file:taxonomy.json#/position_topics" },
          "stance": { "type": "string", "maxLength": 800 },
          "status": { "enum": ["asserted", "discussed", "open"] },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["url"],
              "additionalProperties": false,
              "properties": {
                "url": { "type": "string" },
                "quote": { "type": "string", "maxLength": 600 },
                "date": { "type": "string", "maxLength": 40 }
              }
            }
          }
        }
      }
    },
    "activities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "description"],
        "additionalProperties": false,
        "properties": {
          "type": { "$ref": "file:taxonomy.json#/activity_types" },
          "description": { "type": "string", "maxLength": 600 },
          "proofs": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "cooperation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "offers": {
          "type": "array",
          "description": "Что организация реально может предложить партнёрам",
          "items": {
            "type": "object",
            "required": ["format", "description"],
            "additionalProperties": false,
            "properties": {
              "format": { "$ref": "file:taxonomy.json#/interaction_formats" },
              "description": { "type": "string", "maxLength": 400 }
            }
          }
        },
        "seeks": {
          "type": "array",
          "description": "Что организация ищет у партнёров",
          "items": { "$ref": "#/properties/cooperation/properties/offers/items" }
        },
        "conditions": { "type": "array", "items": { "type": "string", "maxLength": 400 } },
        "red_lines": { "type": "array", "items": { "type": "string", "maxLength": 400 }, "description": "Что не может входить в совместные документы без отдельного согласования" }
      }
    },
    "visibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "level": { "enum": ["public", "restricted"], "description": "restricted — паспорт скрыт, в реестре только строка «существует»" },
        "contacts_public": { "type": "boolean" }
      }
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "list_section": { "type": "string", "maxLength": 120 },
        "page_status": { "type": "string", "maxLength": 80 },
        "page_category": { "enum": ["A", "B", "C", "D", "E", null] },
        "date_checked": { "type": "string", "maxLength": 40 },
        "source": { "type": "string" },
        "notes": { "type": "string", "maxLength": 600 }
      }
    }
  }
}
